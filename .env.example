# Sustain Insight local environment template
# Copy to .env and replace CHANGE_ME values. Never commit the real .env.

# Application
PORT=5000
BRAND_NAME=Sustain Insight
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sustain_insight
PGUSER=postgres
PGPASSWORD=CHANGE_ME
PGSSLMODE=disable

# Database migrations
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1
FLYWAY_VALIDATE_ON_MIGRATE=true
FLYWAY_CLEAN_DISABLED=true

# JWT
JWT_KEY=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Transactional email - Brevo
EMAIL_PROVIDER=brevo
BREVO_API_KEY=CHANGE_ME_BREVO_API_KEY
BREVO_SENDER_EMAIL=no-reply@your-domain.com
BREVO_SENDER_NAME=Sustain Insight

# External news providers
NEWS_API_KEY=CHANGE_ME
GUARDIAN_API_KEY=CHANGE_ME

# AI providers
OPEN_AI_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME

# Feed / pagination
FEED_HOURS_WINDOW=24
PAGINATION_DEFAULT_SIZE=20
PAGINATION_MAX_SIZE=100
LATEST_DEFAULT_LIMIT=10
LATEST_MAX_LIMIT=50

# Scheduled news fetching
NEWS_FETCHING_ENABLED=true
NEWS_FETCHING_DELAY=3600000
NEWS_FETCHING_SCHEDULED_LIMIT=50

# Content processing
SYNTHESIS_TRIGGER_THRESHOLD=3
CLUSTERING_TFIDF_THRESHOLD=0.3

# Password hashing
SECURITY_PASSWORD_ARGON2_SALT_LENGTH=16
SECURITY_PASSWORD_ARGON2_HASH_LENGTH=32
SECURITY_PASSWORD_ARGON2_PARALLELISM=1
SECURITY_PASSWORD_ARGON2_MEMORY=8192
SECURITY_PASSWORD_ARGON2_ITERATIONS=2
